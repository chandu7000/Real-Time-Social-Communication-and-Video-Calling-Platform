# Backend
PORT=7001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/social_communication
JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
STREAM_API_KEY=replace-with-your-stream-api-key
STREAM_API_SECRET=replace-with-your-stream-api-secret

# Frontend
VITE_API_BASE_URL=http://localhost:7001/api
VITE_STREAM_API_KEY=replace-with-your-stream-api-key

# Authentication protection
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
